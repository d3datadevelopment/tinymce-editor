{
  "name": "d3/tinymce-editor",
  "description": "TinyMCE Integration for OXID-Shop",
  "keywords": [
    "TinyMCE",
    "WYSIWYG",
    "Editor",
    "OXID"
  ],
  "type": "oxideshop-module",
  "homepage": "https://www.o3-shop.com/",
  "license": [
    "GPL-3.0"
  ],
  "authors": [
    {
      "name": "Marat Bedoev, bestlife AG",
      "email": "hello@mb-dev.pro"
    },
    {
      "name": "O3-Shop",
      "email": "info@o3-shop.com"
    },
    {
      "name": "D3 Data Development (Inh. Thomas Dartsch)",
      "email": "info@d3data.de"
    }
  ],
  "archive": {
    "exclude": ["/build"]
  },
  "require": {
    "php": "^8.0",
    "oxid-esales/oxideshop-ce": "7.0 - 7.4",
    "d3/oxidservicebridges": "^2.1",
    "d3/oxid-twig-extensions": "^1.3",
    "ajgl/composer-symlinker": "^0.3.1",
    "tinymce/tinymce": "8.0.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.64.0",
    "boxblinkracer/phpunuhi": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "O3\\TinyMCE\\": "./"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "O3\\TinyMCE\\Tests": "./Tests"
    }
  },
  "scripts": {
    "php-cs-fixer_audit": "./vendor/bin/php-cs-fixer list-files --config=./vendor/d3/tinymce-editor/.php-cs-fixer.php",
    "php-cs-fixer_fix": "./vendor/bin/php-cs-fixer fix --config=./vendor/d3/tinymce-editor/.php-cs-fixer.php",

    "phpstan": "./vendor/bin/phpstan analyse -c./vendor/d3/tinymce-editor/phpstan.neon",

    "phpunit": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --config=vendor/d3/tinymce-editor --no-coverage",
    "phpunit-coverage": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --config=vendor/d3/tinymce-editor --coverage-html=reports/phpunit/tinymce-editor",
    "phpunit-path-coverage": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --config=vendor/d3/tinymce-editor --coverage-html=reports/phpunit/tinymce-editor --path-coverage",

    "phpunuhi": "./vendor/bin/phpunuhi --configuration=vendor/d3/tinymce-editor/phpunuhi.xml validate"
  }
}


